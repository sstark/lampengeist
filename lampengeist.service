[Unit]
Description=Lampengeist Presence Simulation

[Service]
# %h is the user's home directory. Adjust if you keep the binary elsewhere;
# WorkingDirectory is where config.json is read and written.
ExecStart=%h/git/lampengeist/lampengeist
WorkingDirectory=%h/git/lampengeist
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
